import math
import curses
import numpy as np

# ----------------- DOMAIN CLASSES -----------------

class Student:
    def __init__(self, s_id, name, dob):
        self.__id = s_id
        self.__name = name
        self.__dob = dob
        self.__marks = {}  # {course_id: mark}
        self.__gpa = 0.0

    def get_id(self):
        return self.__id

    def get_name(self):
        return self.__name

    def get_dob(self):
        return self.__dob

    def get_marks(self):
        return self.__marks

    def get_gpa(self):
        return self.__gpa

    def set_mark(self, course_id, mark):
        self.__marks[course_id] = mark

    def calculate_gpa(self, courses):
        """Tính GPA dùng mảng numpy (weighted sum)"""
        marks_list = []
        credits_list = []

        for c in courses:
            c_id = c.get_id()
            if c_id in self.__marks:
                marks_list.append(self.__marks[c_id])
                credits_list.append(c.get_credits())

        if not credits_list or sum(credits_list) == 0:
            self.__gpa = 0.0
            return 0.0

        # Chuyển đổi sang numpy array
        np_marks = np.array(marks_list, dtype=float)
        np_credits = np.array(credits_list, dtype=float)

        # GPA = tổng (điểm * tín chỉ) / tổng tín chỉ
        self.__gpa = np.sum(np_marks * np_credits) / np.sum(np_credits)
        return self.__gpa


class Course:
    def __init__(self, c_id, name, credits):
        self.__id = c_id
        self.__name = name
        self.__credits = credits

    def get_id(self):
        return self.__id

    def get_name(self):
        return self.__name

    def get_credits(self):
        return self.__credits


# ----------------- HÀM XỬ LÝ TOÁN HỌC -----------------

def round_down_1_decimal(score):
    """Làm tròn xuống 1 chữ số thập phân dùng math.floor()"""
    return math.floor(score * 10) / 10.0


# ----------------- HÀM NHẬP DỮ LIỆU CONSOLE -----------------

def input_system():
    students = []
    courses = []

    # Nhập danh sách sinh viên
    num_students = int(input("Enter number of students: "))
    for _ in range(num_students):
        s_id = input("Student ID: ").strip()
        name = input("Student Name: ").strip()
        dob = input("Student DoB (DD/MM/YYYY): ").strip()
        students.append(Student(s_id, name, dob))

    # Nhập danh sách môn học
    num_courses = int(input("\nEnter number of courses: "))
    for _ in range(num_courses):
        c_id = input("Course ID: ").strip()
        name = input("Course Name: ").strip()
        credits = int(input("Credits: "))
        courses.append(Course(c_id, name, credits))

    # Nhập điểm cho từng môn
    print("\n--- Enter Marks ---")
    for c in courses:
        print(f"\nEntering marks for course: {c.get_name()} ({c.get_id()})")
        for s in students:
            raw_mark = float(input(f"Mark for student {s.get_name()} (ID: {s.get_id()}): "))
            # Áp dụng làm tròn xuống 1 chữ số thập phân
            valid_mark = round_down_1_decimal(raw_mark)
            s.set_mark(c.get_id(), valid_mark)

    # Tính GPA cho từng sinh viên
    for s in students:
        s.calculate_gpa(courses)

    # Sắp xếp danh sách sinh viên theo GPA giảm dần (dùng np.argsort hoặc sort key)
    students.sort(key=lambda s: s.get_gpa(), reverse=True)

    return students, courses


# ----------------- GIAO DIỆN CURSES -----------------

def display_curses(stdscr, students, courses):
    # Khởi tạo màu sắc
    curses.curs_set(0)
    curses.start_color()
    curses.init_pair(1, curses.COLOR_CYAN, curses.COLOR_BLACK)
    curses.init_pair(2, curses.COLOR_YELLOW, curses.COLOR_BLACK)
    curses.init_pair(3, curses.COLOR_GREEN, curses.COLOR_BLACK)

    stdscr.clear()

    # Tiêu đề
    title = "=== STUDENT MANAGEMENT SYSTEM (SORTED BY GPA) ==="
    stdscr.attron(curses.color_pair(1) | curses.A_BOLD)
    stdscr.addstr(1, 2, title)
    stdscr.attroff(curses.color_pair(1) | curses.A_BOLD)

    # Header bảng
    header = f"{'ID':<10} | {'Name':<20} | {'DoB':<12} | {'GPA':<6} | Marks (Course: Score)"
    stdscr.attron(curses.color_pair(2) | curses.A_UNDERLINE)
    stdscr.addstr(3, 2, header)
    stdscr.attroff(curses.color_pair(2) | curses.A_UNDERLINE)

    # Dòng dữ liệu
    row = 4
    for s in students:
        # Chuỗi điểm các môn
        marks_str = ", ".join([f"{cid}: {mark}" for cid, mark in s.get_marks().items()])
        line = f"{s.get_id():<10} | {s.get_name():<20} | {s.get_dob():<12} | {s.get_gpa():<6.2f} | {marks_str}"
        stdscr.addstr(row, 2, line)
        row += 1

    # Hướng dẫn thoát
    stdscr.attron(curses.color_pair(3))
    stdscr.addstr(row + 2, 2, "Press any key to exit...")
    stdscr.attroff(curses.color_pair(3))

    stdscr.refresh()
    stdscr.getch()


# ----------------- MAIN -----------------

def main():
    students, courses = input_system()
    # Hiển thị UI bằng curses
    curses.wrapper(lambda stdscr: display_curses(stdscr, students, courses))


if __name__ == "__main__":
    main()